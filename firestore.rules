rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    function isListingOwner(data) {
      return isAuthed() && (
        data.userId == request.auth.uid ||
        data.agentId == request.auth.uid
      );
    }

    function hasValidListingStatus() {
      return request.resource.data.status in [
        'Aktif',
        'Active',
        'Booking',
        'Sold',
        'Terjual',
        'Draft',
        'Under Loan',
        'Under SPA',
        'Expired',
        'Sewa'
      ];
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;

      // Push registrations for update notifications. Each signed-in user may
      // only read or modify the devices recorded under their own account, so a
      // token can never be listed or harvested by another agent.
      match /devices/{deviceId} {
        allow read, write: if isAuthed() && request.auth.uid == userId;
      }
    }

    match /invite_codes/{code} {
      allow read: if true;
      allow write: if true;
    }

    match /inviteCodes/{code} {
      allow read: if true;
      allow write: if true;
    }

    match /announcements/{annId} {
      allow read: if true;
      allow write: if true;
    }

    match /cases/{caseId} {
      // Reads and deletes: existing document must belong to the caller.
      allow read, delete: if isAuthed()
        && resource.data.userId == request.auth.uid;

      // Creates: the new document must claim the caller's UID as owner.
      allow create: if isAuthed()
        && request.resource.data.userId == request.auth.uid;

      // Updates: the existing document must already belong to the caller,
      // and the incoming data must not transfer ownership to another UID.
      allow update: if isAuthed()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /listings/{listingId} {
      // Only the listing owner (agentId or userId) may read a listing.
      // This prevents other authenticated agents from accessing sensitive
      // owner documents (IC, geran, SPA, utility bills) embedded in the record.
      allow read: if isListingOwner(resource.data);
      allow create: if isAuthed()
        && isListingOwner(request.resource.data)
        && hasValidListingStatus();
      allow update: if isAuthed()
        && isListingOwner(resource.data)
        && isListingOwner(request.resource.data)
        && hasValidListingStatus();
      allow delete: if isAuthed() && isListingOwner(resource.data);
    }

    match /publicListings/{listingId} {
      // Safe listing projection (no owner IC/documents) accessible for mobile agents and web portal
      allow read: if true;
      allow create: if isAuthed()
        && request.resource.data.agentId == request.auth.uid;
      allow update: if isAuthed()
        && resource.data.agentId == request.auth.uid
        && request.resource.data.agentId == request.auth.uid;
      allow delete: if isAuthed()
        && resource.data.agentId == request.auth.uid;
    }

    // Release announcement bookkeeping is written only by the trusted
    // server-side release notifier, which uses a service account and bypasses
    // these rules. Clients get no access.
    match /appReleaseNotifications/{releaseId} {
      allow read, write: if false;
    }
  }
}
