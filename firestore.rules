rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    function isListingOwner(data) {
      return isAuthed() && (
        data.userId == request.auth.uid ||
        data.agentId == request.auth.uid
      );
    }

    function hasValidListingStatus() {
      return request.resource.data.status in [
        'Aktif',
        'Active',
        'Booking',
        'Sold',
        'Terjual',
        'Draft',
        'Under Loan',
        'Under SPA',
        'Expired',
        'Sewa'
      ];
    }

    match /users/{userId} {
      // Only authenticated users can read user profiles.
      // Agents can read other agents' basic info (name, photo) for
      // the "uploaded by" attribution on shared public listings.
      allow read: if isAuthed();

      // Users may only create or modify their own profile document.
      allow write: if isAuthed() && request.auth.uid == userId;

      // Push registrations for update notifications. Each signed-in user may
      // only read or modify the devices recorded under their own account, so a
      // token can never be listed or harvested by another agent.
      match /devices/{deviceId} {
        allow read, write: if isAuthed() && request.auth.uid == userId;
      }
    }

    match /invite_codes/{code} {
      // Unauthenticated read is required because email registration validates
      // the invite code BEFORE creating the Firebase Auth account.
      allow read: if true;
      // Agents can update codes to claim them (status → USED) after signing in.
      // Creating new codes or deleting codes is restricted to admin/Cloud Functions.
      allow update: if isAuthed();
      allow create, delete: if false;
    }

    match /inviteCodes/{code} {
      allow read: if true;
      allow update: if isAuthed();
      allow create, delete: if false;
    }

    match /announcements/{annId} {
      // All authenticated agents can read announcements.
      allow read: if isAuthed();
      // Only Cloud Functions (service account) can create/modify announcements.
      // The admin dashboard creates announcements via the sendBroadcastPush
      // Cloud Function which bypasses these rules.
      allow write: if false;
    }

    // Agent feedback submissions (bug reports, feature requests).
    // Agents can submit feedback; only Cloud Functions / admin can read it.
    match /feedback/{docId} {
      allow create: if isAuthed();
      allow read, update, delete: if false;
    }

    // Self-learning geocoding cache populated by the location service.
    // Any authenticated agent can read cached locations and contribute new ones.
    match /locationKnowledgeBase/{docId} {
      allow read, create, update: if isAuthed();
      allow delete: if false;
    }

    match /cases/{caseId} {
      // Reads and deletes: existing document must belong to the caller.
      allow read, delete: if isAuthed()
        && resource.data.userId == request.auth.uid;

      // Creates: the new document must claim the caller's UID as owner.
      allow create: if isAuthed()
        && request.resource.data.userId == request.auth.uid;

      // Updates: the existing document must already belong to the caller,
      // and the incoming data must not transfer ownership to another UID.
      allow update: if isAuthed()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /listings/{listingId} {
      // Only the listing owner (agentId or userId) may read a listing.
      // This prevents other authenticated agents from accessing sensitive
      // owner documents (IC, geran, SPA, utility bills) embedded in the record.
      allow read: if isListingOwner(resource.data);
      allow create: if isAuthed()
        && isListingOwner(request.resource.data)
        && hasValidListingStatus();
      allow update: if isAuthed()
        && isListingOwner(resource.data)
        && isListingOwner(request.resource.data)
        && hasValidListingStatus();
      allow delete: if isAuthed() && isListingOwner(resource.data);
    }

    match /publicListings/{listingId} {
      // Safe listing projection (no owner IC/documents) accessible for mobile agents and web portal
      allow read: if true;
      allow create: if isAuthed()
        && request.resource.data.agentId == request.auth.uid;
      allow update: if isAuthed()
        && resource.data.agentId == request.auth.uid
        && request.resource.data.agentId == request.auth.uid;
      allow delete: if isAuthed()
        && resource.data.agentId == request.auth.uid;
    }

    // Release announcement bookkeeping is written only by the trusted
    // server-side release notifier, which uses a service account and bypasses
    // these rules. Clients get no access.
    match /appReleaseNotifications/{releaseId} {
      allow read, write: if false;
    }
  }
}
