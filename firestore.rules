rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.uid == 'super_admin_web_portal' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isListingOwner(data) {
      return isAuthed() && (
        data.userId == request.auth.uid ||
        data.agentId == request.auth.uid
      );
    }

    function hasValidListingStatus() {
      return request.resource.data.status in [
        'Aktif', 'Active', 'Booking', 'Sold', 'Terjual',
        'Draft', 'Under Loan', 'Under SPA', 'Expired', 'Sewa'
      ];
    }

    // ─────────────────────────────────────────────
    // 👤 User Profiles & Agent Directory
    // ─────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated agent can read profiles (needed for listings, co-broke, directory)
      allow read: if isAuthed();

      // Registration: user creates their own doc; cannot self-assign admin role
      // Registration: authenticated user creates their own profile
      // Constraint: cannot self-assign admin role (use .get() with default to handle missing field)
      allow create: if isAuthed()
                    && request.auth.uid == userId
                    && request.resource.data.get('role', 'agent') != 'admin';

      // Admins can create docs for any user (e.g. agent onboarding from web portal)
      allow create: if isAdmin();

      // Profile updates: own-account changes are always allowed except self-promotion to admin.
      // Admin role is also allowed to update anything.
      allow update: if isAuthed() && (
        isAdmin()
        || (request.auth.uid == userId && request.resource.data.get('role', resource.data.get('role', 'agent')) != 'admin')
      );

      // Delete: admin only
      allow delete: if isAdmin();

      // Push notification device tokens
      match /devices/{deviceId} {
        allow read, write: if isAuthed() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ─────────────────────────────────────────────
    // 🔑 Invite Codes (Registration Gate)
    // ─────────────────────────────────────────────
    match /invite_codes/{code} {
      // Public read: registration validates invite code BEFORE Firebase Auth account exists
      allow read: if true;
      // Update: agents claim codes (status → USED) during registration; admins manage all
      allow update: if true;
      // Create/delete: require authentication (web admin portal signs in via custom token)
      allow create, delete: if isAuthed();
    }

    match /inviteCodes/{code} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if isAuthed();
    }

    // ─────────────────────────────────────────────
    // 📢 Announcements & Bulletins
    // ─────────────────────────────────────────────
    match /announcements/{annId} {
      // Authenticated agents can read the feed
      allow read: if isAuthed();
      // Only admins (incl. web portal custom-token user) can broadcast
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 🐛 Feedback & Bug Reports
    // ─────────────────────────────────────────────
    match /feedback/{docId} {
      // Agents submit their own reports
      allow create: if isAuthed() &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);

      // Agents read/delete only their own tickets; admins see all
      allow read, delete: if isAuthed() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email ||
        isAdmin()
      );

      // Only admins update status / adminResponse
      allow update: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 📍 Location Knowledge Base (geocoding cache)
    // ─────────────────────────────────────────────
    match /locationKnowledgeBase/{docId} {
      allow read, create, update: if isAuthed();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 💼 Property Cases (Deal Pipeline)
    // ─────────────────────────────────────────────
    match /cases/{caseId} {
      allow read, delete: if isAuthed() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthed() &&
        (request.resource.data.userId == request.auth.uid || isAdmin());

      allow update: if isAuthed() && (
        (resource.data.userId == request.auth.uid &&
         request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────
    // 🏠 Private Listings (owner IC / documents)
    // ─────────────────────────────────────────────
    match /listings/{listingId} {
      allow read: if isListingOwner(resource.data) || isAdmin();
      allow create: if isAuthed() &&
        (isListingOwner(request.resource.data) || isAdmin()) &&
        hasValidListingStatus();
      allow update: if isAuthed() && (
        (isListingOwner(resource.data) && isListingOwner(request.resource.data)) ||
        isAdmin()
      ) && hasValidListingStatus();
      allow delete: if isAuthed() && (isListingOwner(resource.data) || isAdmin());
    }

    // ─────────────────────────────────────────────
    // 🌐 Public Listings (co-broking feed)
    // ─────────────────────────────────────────────
    match /publicListings/{listingId} {
      // Authenticated agents only — not fully public
      allow read: if isAuthed();
      allow create: if isAuthed() &&
        (request.resource.data.agentId == request.auth.uid || isAdmin());
      allow update: if (
        isAuthed() && (
          (resource.data.agentId == request.auth.uid &&
           request.resource.data.agentId == request.auth.uid) ||
          isAdmin()
        )
      ) || (
        // Allow status-only updates (e.g. admin endpoint via Admin SDK bypasses rules anyway)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        hasValidListingStatus()
      );
      allow delete: if isAuthed() && (resource.data.agentId == request.auth.uid || isAdmin());
    }

    // ─────────────────────────────────────────────
    // 🚀 App Release Notifications
    // ─────────────────────────────────────────────
    match /appReleaseNotifications/{releaseId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 🔒 Admin Session Audit Log
    // ─────────────────────────────────────────────
    match /_admin_sessions/{sessionId} {
      // Written by Cloud Function (Admin SDK — bypasses rules)
      // Client reads blocked; no need for client access
      allow read, write: if false;
    }
  }
}
