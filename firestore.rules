rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed() && (
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('isSuperAdmin', false) == true ||
        request.auth.uid == 'super_admin_web_portal' ||
        (
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '').lower() in ['norazrul7@gmail.com', 'shazaima17@gmail.com']
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '').lower() == 'admin'
        )
      );
    }

    function isListingOwner(data) {
      return isAuthed() && (
        data.userId == request.auth.uid ||
        data.agentId == request.auth.uid
      );
    }

    function hasValidListingStatus() {
      return request.resource.data.status in [
        'Aktif', 'Active', 'Booking', 'Sold', 'Terjual',
        'Draft', 'Under Loan', 'Under SPA', 'Expired', 'Sewa'
      ];
    }

    // ─────────────────────────────────────────────
    // 👤 User Profiles & Agent Directory
    // ─────────────────────────────────────────────
    match /users/{userId} {
      // Authenticated agents can read directory profiles
      allow read: if isAuthed();

      // Registration: User must create their own profile with role 'agent' and pending approval status
      allow create: if isAuthed() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.get('role', 'agent').lower() == 'agent' &&
          request.resource.data.get('approved', false) == false
        )
      );

      // Profile Updates: Users CANNOT change their role, approved status, or status. Admins can update anything.
      allow update: if isAuthed() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'approved', 'status', 'registeredWithCode', 'inviteCodeUsed'
          ])
        )
      );

      // Delete: Admin or user deleting own account
      allow delete: if isAdmin() || (isAuthed() && request.auth.uid == userId);

      // Push notification device tokens
      match /devices/{deviceId} {
        allow read, write: if isAuthed() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ─────────────────────────────────────────────
    // 🔑 Invite Codes (Registration Gate)
    // ─────────────────────────────────────────────
    match /invite_codes/{code} {
      // Allow single code lookup by exact code; admins can list
      allow get: if isAuthed();
      allow list: if isAdmin();

      // Allow claiming an UNUSED code during registration (must be authenticated)
      allow update: if isAdmin() || (
        isAuthed() &&
        resource.data.get('status', 'UNUSED') == 'UNUSED' &&
        request.resource.data.get('status', '') == 'USED' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'usedAt', 'claimedByEmail', 'updatedAt'])
      );

      // Only admins can generate or revoke codes
      allow create, delete: if isAdmin();
    }

    match /inviteCodes/{code} {
      allow get: if isAuthed();
      allow list: if isAdmin();
      allow update: if isAdmin() || (
        isAuthed() &&
        resource.data.get('status', 'UNUSED') == 'UNUSED' &&
        request.resource.data.get('status', '') == 'USED' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'usedAt', 'claimedByEmail', 'updatedAt'])
      );
      allow create, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 📢 Announcements & Bulletins
    // ─────────────────────────────────────────────
    match /announcements/{annId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 🐛 Feedback & Bug Reports
    // ─────────────────────────────────────────────
    match /feedback/{docId} {
      allow create: if isAuthed() &&
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);

      allow read, delete: if isAuthed() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email ||
        isAdmin()
      );

      allow update: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 📍 Location Knowledge Base (geocoding cache)
    // ─────────────────────────────────────────────
    match /locationKnowledgeBase/{docId} {
      allow read, create, update: if isAuthed();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 💼 Property Cases (Deal Pipeline)
    // ─────────────────────────────────────────────
    match /cases/{caseId} {
      allow read, delete: if isAuthed() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthed() &&
        (request.resource.data.userId == request.auth.uid || isAdmin());

      allow update: if isAuthed() && (
        (resource.data.userId == request.auth.uid &&
         request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }

    // ─────────────────────────────────────────────
    // 🏠 Private Listings (owner IC / documents)
    // ─────────────────────────────────────────────
    match /listings/{listingId} {
      allow read: if isListingOwner(resource.data) || isAdmin();
      allow create: if isAuthed() &&
        (isListingOwner(request.resource.data) || isAdmin()) &&
        hasValidListingStatus();
      allow update: if isAuthed() && (
        (isListingOwner(resource.data) && isListingOwner(request.resource.data)) ||
        isAdmin()
      ) && hasValidListingStatus();
      allow delete: if isAuthed() && (isListingOwner(resource.data) || isAdmin());
    }

    // ─────────────────────────────────────────────
    // 🌐 Public Listings (co-broking feed)
    // ─────────────────────────────────────────────
    match /publicListings/{listingId} {
      // Authenticated agents only — not fully public
      allow read: if isAuthed();
      // Block sensitive document vault attachments from ever being written to publicListings
      allow create: if isAuthed() &&
        (request.resource.data.agentId == request.auth.uid || isAdmin()) &&
        !('documents' in request.resource.data);
      allow update: if isAuthed() && (
        (resource.data.agentId == request.auth.uid &&
         request.resource.data.agentId == request.auth.uid &&
         !('documents' in request.resource.data)) ||
        isAdmin()
      );
      allow delete: if isAuthed() && (resource.data.agentId == request.auth.uid || isAdmin());
    }

    // ─────────────────────────────────────────────
    // 🚀 App Release Notifications
    // ─────────────────────────────────────────────
    match /appReleaseNotifications/{releaseId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 🔒 Admin Session Audit Log
    // ─────────────────────────────────────────────
    match /_admin_sessions/{sessionId} {
      // Written by Cloud Function (Admin SDK — bypasses rules)
      // Client reads blocked; no need for client access
      allow read, write: if false;
    }
  }
}
