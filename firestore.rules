rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        request.auth.token.isSuperAdmin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isListingOwner(data) {
      return isAuthed() && (
        data.userId == request.auth.uid ||
        data.agentId == request.auth.uid
      );
    }

    function hasValidListingStatus() {
      return request.resource.data.status in [
        'Aktif',
        'Active',
        'Booking',
        'Sold',
        'Terjual',
        'Draft',
        'Under Loan',
        'Under SPA',
        'Expired',
        'Sewa'
      ];
    }

    // 👤 User Profiles & Directory
    match /users/{userId} {
      // Authenticated users can read agent profiles for app operation and directory
      allow read: if isAuthed();
      
      // Registration: User can create their own profile document, but CANNOT self-assign admin role
      allow create: if isAuthed() && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin());

      // Update: User can update their own profile, but CANNOT modify security-sensitive fields (role, approved, status) unless they are admin
      allow update: if isAuthed() && (
        isAdmin() || (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved', 'status'])
        )
      );

      // Deletion: Admin only
      allow delete: if isAdmin();

      // Push notification token registrations
      match /devices/{deviceId} {
        allow read, write: if isAuthed() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 🎫 Invite Codes (Used during registration)
    match /invite_codes/{code} {
      // Pre-registration read is allowed to validate code before Firebase Auth user creation
      allow read: if true;
      // Claiming an invite code (status → USED)
      allow update: if isAuthed() || isAdmin();
      // Only admins can create or delete invite codes
      allow create, delete: if isAdmin();
    }

    match /inviteCodes/{code} {
      allow read: if true;
      allow update: if isAuthed() || isAdmin();
      allow create, delete: if isAdmin();
    }

    // 📢 System Announcements & Bulletins
    match /announcements/{annId} {
      // Authenticated agents can read announcements feed
      allow read: if isAuthed();
      // Only admins can create, edit, or delete broadcasts
      allow write: if isAdmin();
    }

    // 🐛 Feedback & Bug Reports
    match /feedback/{docId} {
      // Authenticated agents can submit feedback
      allow create: if isAuthed() && (
        !('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid
      );
      // Agents can read and delete only their own submissions; Admins can read/manage all
      allow read, delete: if isAuthed() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email ||
        isAdmin()
      );
      // Only admins can update status or adminResponse
      allow update: if isAdmin();
    }

    // 📍 Location Knowledge Base (Self-learning geocoding cache)
    match /locationKnowledgeBase/{docId} {
      allow read, create, update: if isAuthed();
      allow delete: if isAdmin();
    }

    // 💼 Property Cases (Deal & Pipeline Management)
    match /cases/{caseId} {
      // Reads and deletes: existing document must belong to caller or admin
      allow read, delete: if isAuthed()
        && (resource.data.userId == request.auth.uid || isAdmin());

      // Creates: new document must claim caller's UID as owner (or admin creating for an agent)
      allow create: if isAuthed()
        && (request.resource.data.userId == request.auth.uid || isAdmin());

      // Updates: existing document must belong to caller (or admin)
      allow update: if isAuthed()
        && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    // 🏠 Property Listings (Private Details & Documents)
    match /listings/{listingId} {
      allow read: if isListingOwner(resource.data) || isAdmin();
      allow create: if isAuthed()
        && (isListingOwner(request.resource.data) || isAdmin())
        && hasValidListingStatus();
      allow update: if isAuthed()
        && (
          (isListingOwner(resource.data) && isListingOwner(request.resource.data)) ||
          isAdmin()
        )
        && hasValidListingStatus();
      allow delete: if isAuthed() && (isListingOwner(resource.data) || isAdmin());
    }

    // 🌐 Public Listings (Safe projection for co-broking and marketplace)
    match /publicListings/{listingId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && (request.resource.data.agentId == request.auth.uid || isAdmin());
      allow update: if (
          isAuthed() && (
            (resource.data.agentId == request.auth.uid && request.resource.data.agentId == request.auth.uid) ||
            isAdmin()
          )
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          hasValidListingStatus()
        );
      allow delete: if isAuthed()
        && (resource.data.agentId == request.auth.uid || isAdmin());
    }

    // 🚀 App Release Notifications Bookkeeping
    match /appReleaseNotifications/{releaseId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }
  }
}
