modules = ["nodejs-20", "python-base-3.13"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Build Android APK"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CI=1 npx expo start --web --port 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "Build Android APK"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export JAVA_HOME=/nix/store/xad649j61kwkh0id5wvyiab5rliprp4d-openjdk-17.0.15+6; export NODE_HOME=/nix/store/jfar9wnj6kvr0gr6klh1gk7vgckkfr5j-nodejs-20.20.0; export PATH=$NODE_HOME/bin:$JAVA_HOME/bin:$PWD/.android-sdk/cmdline-tools/latest/bin:$PWD/.android-sdk/platform-tools:$PWD/.android-sdk/build-tools/36.0.0:$PATH; export ANDROID_HOME=$PWD/.android-sdk ANDROID_SDK_ROOT=$PWD/.android-sdk; export JAVA_TOOL_OPTIONS=-XX:-UsePerfData; export GRADLE_OPTS='-Dorg.gradle.jvmargs=-Xmx2048m -XX:-UsePerfData'; cd android && ./gradlew assembleRelease --no-daemon --console=plain --max-workers=2 -PreactNativeArchitectures=arm64-v8a"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]

[deployment]
deploymentTarget = "cloudrun"
build = ["npm", "run", "build"]
run = ["npx", "serve", "dist", "--single", "--listen", "8080"]
