rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthed() {
      return request.auth != null;
    }

    // Property listings documents (SPA, IC, Geran, Utility bills, Photos, Videos)
    // Files are uploaded under listings/{listingId}/{fileName}
    match /listings/{listingId}/{allPaths=**} {
      // Any authenticated agent can read property photos/documents
      // Authenticated agents can upload files with generous limit (200MB)
      allow read: if isAuthed();
      allow write: if isAuthed()
        && request.resource.size < 200 * 1024 * 1024;
    }

    // Feedback screenshots & attachments (feedback/{feedbackId}/{fileName})
    match /feedback/{feedbackId}/{allPaths=**} {
      allow read: if isAuthed();
      allow write: if isAuthed()
        && request.resource.size < 50 * 1024 * 1024;
    }

    // User profile pictures (users/{userId}/{fileName})
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthed();
      allow write: if isAuthed()
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Fallback: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
