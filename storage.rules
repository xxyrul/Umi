rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthed() {
      return request.auth != null;
    }

    function isListingOwner(listingId) {
      return isAuthed() && (
        firestore.get(/databases/(default)/documents/listings/$(listingId)).data.userId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/listings/$(listingId)).data.agentId == request.auth.uid
      );
    }

    // Property listing files
    // 1. Photos (gambar_*) are public to all authenticated agents.
    // 2. Private documents (geran, IC, SPA, etc) can ONLY be read by the owner.
    match /listings/{listingId}/{fileName} {
      allow read: if isAuthed() && (fileName.matches('gambar_.*') || isListingOwner(listingId));
      allow write: if isAuthed() && request.resource.size < 200 * 1024 * 1024;
    }

    // Catch-all for any nested sub-paths (just in case)
    match /listings/{listingId}/{subPath=**} {
      allow read: if isAuthed() && isListingOwner(listingId);
      allow write: if isAuthed() && request.resource.size < 200 * 1024 * 1024;
    }

    // Feedback screenshots & attachments (feedback/{feedbackId}/{fileName})
    match /feedback/{feedbackId}/{allPaths=**} {
      allow read: if isAuthed();
      allow write: if isAuthed()
        && request.resource.size < 50 * 1024 * 1024;
    }

    // User profile pictures (users/{userId}/{fileName})
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthed();
      allow write: if isAuthed()
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Fallback: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
