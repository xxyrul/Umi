rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthed() {
      return request.auth != null;
    }

    // Property listings documents (SPA, IC, Geran, Utility bills, Photos)
    // Files are uploaded under listings/{listingId}/{fileName}
    match /listings/{listingId}/{allPaths=**} {
      // Any authenticated agent can read property photos/documents
      // Only authenticated agents can upload files with max size limit (25MB)
      allow read: if isAuthed();
      allow write: if isAuthed()
        && request.resource.size < 25 * 1024 * 1024;
    }

    // Feedback screenshots (feedback/{feedbackId}/{fileName})
    match /feedback/{feedbackId}/{allPaths=**} {
      allow read: if isAuthed();
      allow write: if isAuthed()
        && request.resource.size < 10 * 1024 * 1024;
    }

    // User profile pictures (users/{userId}/{fileName})
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthed();
      allow write: if isAuthed()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Fallback: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
